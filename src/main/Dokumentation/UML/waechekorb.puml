
@startuml
' Paketstruktur
package "implementation" {
  class Kleidungsstueck {
    +Long id
    +String _name
    +int _temperaturIndex
    +boolean _istFuerRegenGeeignet
    +MainCategory _hauptkategorie
    +List<Tags> _tags
    +String _bildURL
    +addTag(tag: Tags)
    +deleteTag(tag: Tags)
  }

  class Waechekorb {
    +Long id
    +String name
    +List<Kleidungsstueck> items
    +addItem(k: Kleidungsstueck)
    +addItems(ids: List<Kleidungsstueck>)
    +removeItem(k: Kleidungsstueck)
    +removeItemsByIds(ids: List<Kleidungsstueck>)
    +clear()
  }
}

package "repository" {
  interface KleidungsstueckRepository <<interface>> {
    +save(...)
    +findById(id: Long)
    +findAll()
    +deleteById(id: Long)
  }
  interface WaechekorbRepository <<interface>> {
    +save(...)
    +findFirstByOrderByIdAsc(): Optional<Waechekorb>
    +deleteById(id: Long)
  }
}

package "service" {
  class KleidungsstueckService {
    +createKleidungsstueck(k: Kleidungsstueck)
    +getAll(): List<Kleidungsstueck>
    +delete(id: Long)
  }
  class WaechekorbService {
    -WaechekorbRepository waechekorbRepository
    -KleidungsstueckRepository kleidungsstueckRepository
    +getSingletonWaechekorb(): Waechekorb
    +getBasket(): Waechekorb
    +addItem(itemId: Long): Waechekorb
    +addItems(itemIds: List<Long>): Waechekorb
    +removeItem(itemId: Long): Waechekorb
    +removeItems(itemIds: List<Long>): Waechekorb
    +clear(): Waechekorb
    +delete(): void
  }
}

package "controller" {
  class WaechekorbController {
    -WaechekorbService service
    +get(): Waechekorb
    +getOrCreate(): Waechekorb
    +delete(): void
    +addItem(itemId: Long): Waechekorb
    +addItems(ids: IdsRequest): Waechekorb
    +removeItem(itemId: Long): Waechekorb
    +removeItems(ids: IdsRequest): Waechekorb
    +clear(): Waechekorb
  }

  class IdsRequest {
    +List<Long> ids
    +getIds(): List<Long>
    +setIds(ids: List<Long>)
  }
}

' Beziehungen / Abhängigkeiten
Waechekorb "1" -- "0..*" Kleidungsstueck : contains
KleidungsstueckRepository ..> Kleidungsstueck : manages
WaechekorbRepository ..> Waechekorb : manages (Singleton)

KleidungsstueckService --> KleidungsstueckRepository : uses
WaechekorbService --> WaechekorbRepository : uses
WaechekorbService --> KleidungsstueckRepository : uses

WaechekorbController --> WaechekorbService : uses
WaechekorbController --> IdsRequest : reads



@enduml