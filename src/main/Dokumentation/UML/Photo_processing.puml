@startuml
title Komponentendiagramm: Photo_processing
skinparam componentStyle rectangle
skinparam shadowing false

package "SEA2 Projekt" {

  [Frontend / Client] as Frontend
  [PhotoController] as PhotoController
  [PhotoProcessingService] as PhotoService
  [BackgroundRemovalAdapter] as BgAdapter
  [Python Script\nremove_bg.py] as RemoveBg
  [PhotoRepository] as PhotoRepo
  database "PhotoDB\n(localDB/photoDB/uploads)" as PhotoDB
  [Dateisystem] as FileSystem

  Frontend --> PhotoController : uploadPhoto(), processPhoto()
  PhotoController --> PhotoService : process(photoId, options)

  PhotoService --> PhotoRepo : saveMetadata(), findById()
  PhotoRepo --> PhotoDB : CRUD

  PhotoService --> FileSystem : saveOriginal(), saveResult()

  PhotoService --> BgAdapter : removeBackground(inputPath)
  BgAdapter --> RemoveBg : Python-Aufruf (Subprozess)

  RemoveBg --> FileSystem : liest/schreibt Bilddateien
  PhotoController --> Frontend : liefert verarbeitete Datei/URL
}

note right of RemoveBg
  Externes Skript:
  scripts/remove_bg.py
end note

@enduml